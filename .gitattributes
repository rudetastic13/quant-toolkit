# Normalize all text files to LF on checkin and checkout.
* text=auto eol=lf

# Explicitly declare common text file types as LF
*.py        text eol=lf
*.pyi       text eol=lf
*.pyx       text eol=lf
*.pxd       text eol=lf
*.ipynb     text eol=lf
*.md        text eol=lf
*.rst       text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cpp       text eol=lf
*.hpp       text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary files — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.whl       binary
*.so        binary
*.dll       binary
*.dylib     binary
*.pyd       binary
*.pyc       binary
*.npy       binary
*.npz       binary
*.parquet   binary
*.feather   binary
*.h5        binary
*.hdf5      binary
*.pkl       binary
*.joblib    binary
